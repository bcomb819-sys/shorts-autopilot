# Copy this file to .env for 24/7 Cloud VPS / Docker deployment
# Tip: Connect YouTube once in the local dashboard, then click "Copy Cloud .env Secrets"

HOST=0.0.0.0
PORT=3456

# Required for 24/7 hands-free YouTube auto-uploading (no approval prompts)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Recommended for infinite 100% unique stories in the cloud (free tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional if running Ollama on the same server
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
